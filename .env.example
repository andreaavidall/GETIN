# ---------------------------------------------------------------------------
# GETIN - variables de entorno. Copia a .env.local y completa.
# Ninguna clave real esta incluida en el repositorio.
# ---------------------------------------------------------------------------

# --- Supabase (obligatorio para auth y base de datos) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA usar el prefijo NEXT_PUBLIC_ con esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "demo" muestra datos ficticios etiquetados; "live" exige Supabase configurado.
NEXT_PUBLIC_DATA_MODE=demo

# --- Pagos ---
# Adaptadores disponibles: "test" (simulador local) | "culqi" (requiere credenciales)
PAYMENTS_PROVIDER=test
# Secreto para firmar/verificar los webhooks del adaptador de pruebas.
PAYMENTS_TEST_WEBHOOK_SECRET=cambia-esto-en-local
# Culqi (dejar vacio hasta tener cuenta; ver docs/PAGOS.md)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=

# --- Comision por defecto de GETIN (puntos base: 700 = 7.00%) ---
GETIN_DEFAULT_COMMISSION_BPS=700

# --- QR ---
# Clave para derivar el HMAC de los tokens QR (32+ bytes aleatorios).
QR_TOKEN_SECRET=cambia-esto-en-local
